<Window x:Class="lab_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система Массового Обслуживания (СМО)" 
        Height="750" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель управления -->
        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Header="Параметры системы" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Среднее время между заявками:"/>
                    <TextBox x:Name="txtMeanGenerationTime" Text="2.0" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Время обслуживания:"/>
                    <TextBox x:Name="txtServiceTime" Text="1.5" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Размер очереди:"/>
                    <TextBox x:Name="txtQueueSize" Text="5" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3" Margin="5">
                    <TextBlock Text="Время моделирования:"/>
                    <TextBox x:Name="txtSimulationTime" Text="50.0" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Выбор распределений -->
        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Распределения" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Распределение для генератора заявок -->
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Распределение для генератора заявок:" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbGeneratorDistribution" Margin="0,5,0,0" SelectionChanged="Distribution_SelectionChanged">
                        <ComboBoxItem Content="Равномерное" Tag="Uniform"/>
                        <ComboBoxItem Content="Экспоненциальное" Tag="Exponential" IsSelected="True"/>
                        <ComboBoxItem Content="Нормальное" Tag="Normal"/>
                        <ComboBoxItem Content="Пуассона" Tag="Poisson"/>
                        <ComboBoxItem Content="Эрланга" Tag="Erlang"/>
                    </ComboBox>
                    
                    <!-- Дополнительные параметры для распределений -->
                    <StackPanel x:Name="pnlGeneratorParams" Margin="0,5,0,0">
                        <TextBlock x:Name="txtGeneratorParam1Label" Text="Параметр 1:"/>
                        <TextBox x:Name="txtGeneratorParam1" Text="2.0" Margin="0,2,0,5"/>
                        <TextBlock x:Name="txtGeneratorParam2Label" Text="Параметр 2:" Visibility="Collapsed"/>
                        <TextBox x:Name="txtGeneratorParam2" Text="0.5" Margin="0,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Распределение для обслуживающего аппарата -->
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Распределение для обслуживающего аппарата:" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbServiceDistribution" Margin="0,5,0,0" SelectionChanged="Distribution_SelectionChanged">
                        <ComboBoxItem Content="Равномерное" Tag="Uniform"/>
                        <ComboBoxItem Content="Экспоненциальное" Tag="Exponential" IsSelected="True"/>
                        <ComboBoxItem Content="Нормальное" Tag="Normal"/>
                        <ComboBoxItem Content="Пуассона" Tag="Poisson"/>
                        <ComboBoxItem Content="Эрланга" Tag="Erlang"/>
                    </ComboBox>
                    
                    <!-- Дополнительные параметры для распределений -->
                    <StackPanel x:Name="pnlServiceParams" Margin="0,5,0,0">
                        <TextBlock x:Name="txtServiceParam1Label" Text="Параметр 1:"/>
                        <TextBox x:Name="txtServiceParam1" Text="1.5" Margin="0,2,0,5"/>
                        <TextBlock x:Name="txtServiceParam2Label" Text="Параметр 2:" Visibility="Collapsed"/>
                        <TextBox x:Name="txtServiceParam2" Text="0.3" Margin="0,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Остальная разметка без изменений -->
        <GroupBox Grid.Row="2" Grid.Column="0" Header="Управление" Margin="0,0,10,0">
            <StackPanel>
                <Button x:Name="btnStepByStep" Content="Пошаговый метод" 
                        Click="BtnStepByStep_Click" Height="40" Margin="5"/>
                <Button x:Name="btnEventBased" Content="Событийный метод" 
                        Click="BtnEventBased_Click" Height="40" Margin="5"/>
                <Button x:Name="btnFindOptimal" Content="Найти оптимальный размер очереди" 
                        Click="BtnFindOptimal_Click" Height="40" Margin="5"/>
                <Button x:Name="btnClear" Content="Очистить результаты" 
                        Click="BtnClear_Click" Height="30" Margin="5,20,5,5" Background="#FFF0F0F0"/>
                
                <ProgressBar x:Name="progressBar" Height="20" Margin="5,20,5,5" 
                           Visibility="Collapsed" IsIndeterminate="True"/>
                
                <GroupBox Header="Статистика" Margin="5,20,5,0">
                    <StackPanel>
                        <TextBlock x:Name="txtTotalRequests" Text="Всего заявок: 0" Margin="5"/>
                        <TextBlock x:Name="txtServedRequests" Text="Обслужено заявок: 0" Margin="5"/>
                        <TextBlock x:Name="txtServiceRate" Text="Процент обслуженных: 0%" Margin="5"/>
                        <TextBlock x:Name="txtLostRequests" Text="Потеряно заявок: 0" Margin="5"/>
                        <TextBlock x:Name="txtCurrentTime" Text="Текущее время: 0.00" Margin="5"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Grid.Column="1" Header="Результаты и лог событий">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TabControl Grid.Row="1">
                    <TabItem Header="Лог событий">
                        <TextBox x:Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                               HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10"/>
                    </TabItem>
                    <TabItem Header="Оптимальная очередь">
                        <TextBox x:Name="txtOptimalQueue" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                               HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов к работе"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>